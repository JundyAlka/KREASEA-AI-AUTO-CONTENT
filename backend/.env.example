# ══════════════════════════════════════════════════════════
# KreaSea Backend — Environment Variables
# ══════════════════════════════════════════════════════════
# Salin file ini menjadi .env dan isi dengan key milikmu.
# JANGAN pernah commit file .env ke GitHub!
# ══════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ─── CORS — URL Flutter / Admin Dashboard ─────────────────
ALLOWED_ORIGINS=http://localhost:8080,https://kreasea.app

# ─── Firebase Admin SDK ───────────────────────────────────
# Dapatkan dari Firebase Console → Project Settings → Service Accounts
# Paste seluruh isi JSON file (dalam satu baris, atau gunakan path file)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Atau alternatif, gunakan path ke file JSON:
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ─── Redis (Upstash — gratis tier tersedia) ───────────────
# Daftar di https://upstash.com/
REDIS_URL=redis://default:your_password@your-endpoint.upstash.io:6379
# Atau jika local development:
# REDIS_URL=redis://localhost:6379

# ══════════════════════════════════════════════════════════
# TEXT GENERATION — 5 API Key Gemini
# Daftar di: https://aistudio.google.com/apikey
# ══════════════════════════════════════════════════════════
GEMINI_TEXT_KEY_1=AIzaSy_your_key_1_here
GEMINI_TEXT_KEY_2=AIzaSy_your_key_2_here
GEMINI_TEXT_KEY_3=AIzaSy_your_key_3_here
GEMINI_TEXT_KEY_4=AIzaSy_your_key_4_here
GEMINI_TEXT_KEY_5=AIzaSy_your_key_5_here

# Model yang digunakan (bisa diubah tanpa redeploy)
GEMINI_TEXT_MODEL=gemini-2.0-flash-exp
GEMINI_VISION_MODEL=gemini-1.5-pro

# ══════════════════════════════════════════════════════════
# IMAGE GENERATION — 5 API Key Stability AI
# Daftar di: https://platform.stability.ai/account/keys
# ══════════════════════════════════════════════════════════
STABILITY_IMAGE_KEY_1=sk-your_stability_key_1
STABILITY_IMAGE_KEY_2=sk-your_stability_key_2
STABILITY_IMAGE_KEY_3=sk-your_stability_key_3
STABILITY_IMAGE_KEY_4=sk-your_stability_key_4
STABILITY_IMAGE_KEY_5=sk-your_stability_key_5

STABILITY_IMAGE_MODEL=stable-diffusion-xl-1024-v1-0

# ══════════════════════════════════════════════════════════
# FALLBACK PROVIDERS (opsional tapi sangat direkomendasikan)
# ══════════════════════════════════════════════════════════

# Fallback Text: OpenAI GPT-4o-mini (murah, reliable)
# Daftar di: https://platform.openai.com/api-keys
OPENAI_FALLBACK_KEY=sk-your_openai_key

# Fallback Image: Replicate (pay-per-use)
# Daftar di: https://replicate.com/account/api-tokens
REPLICATE_FALLBACK_KEY=r8_your_replicate_key

# ─── Rate Limiting Per User ────────────────────────────────
# Berapa request maksimal per user per jam
MAX_REQUESTS_PER_HOUR_FREE=20
MAX_REQUESTS_PER_HOUR_PRO=100
MAX_REQUESTS_PER_HOUR_PREMIUM=500

# ─── Sentry (Monitoring — opsional) ───────────────────────
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
