# ══════════════════════════════════════════════
# Kreasea — Environment Variables
# ══════════════════════════════════════════════
# Copy file ini menjadi .env dan isi dengan API key milikmu.
# JANGAN commit file .env ke GitHub!
#
# Cara mendapatkan API keys:
# - GEMINI_API_KEY    → https://aistudio.google.com/apikey
# - STABILITY_API_KEY → https://platform.stability.ai/account/keys
# ══════════════════════════════════════════════

GEMINI_API_KEY=your_gemini_api_key_here
STABILITY_API_KEY=your_stability_ai_api_key_here
AI_TEXT_API_KEY=your_text_api_key_here
AI_IMAGE_API_KEY=your_image_api_key_here
