# ══════════════════════════════════════════════
# KreaSea Flutter App — Environment Variables
# ══════════════════════════════════════════════
# Copy file ini menjadi .env dan isi sesuai environment.
# JANGAN commit file .env ke GitHub!
#
# PENTING: API Key AI (Gemini, Stability AI) sudah DIPINDAHKAN
# ke backend. Flutter hanya butuh URL backend.
# ══════════════════════════════════════════════

# ─── Backend URL ──────────────────────────────────────────────
# Development: http://localhost:3001
# Production:  https://api.kreasea.app  (atau Railway URL kamu)
BACKEND_URL=http://localhost:3001

# ─── Firebase (tetap dibutuhkan untuk Auth) ───────────────────
# Nilai ini aman di client karena dilindungi Firebase Security Rules
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id
